}

.nav-item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 8px; font-size: 13.5px; color: rgb(45, 63, 82); transition: background 0.15s, color 0.15s; text-decoration: none; white-space: nowrap; overflow: hidden; }

