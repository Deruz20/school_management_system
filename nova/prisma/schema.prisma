// FINANCE: GENERAL LEDGER & DOUBLE ENTRY (PHASE 3.1L)
// ==========================================

enum GLAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  DIRECT_COST
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum SystemControlRole {
  NONE
  AR_STUDENT_CONTROL
  AR_PREPAID_ADVANCES
  AP_SUPPLIER_CONTROL
  AP_GRN_ACCRUAL
  CASH_BANK_CONTROL
  INVENTORY_STORES_ASSET
  INVENTORY_COGS_DEFAULT
  INVENTORY_SHRINKAGE_EXPENSE
  INVENTORY_SURPLUS_INCOME
  PAYROLL_WAGES_EXPENSE
  PAYROLL_EMPLOYER_NSSF_EXPENSE
  PAYROLL_NET_PAY_PAYABLE
  PAYROLL_PAYE_PAYABLE
  PAYROLL_NSSF_PAYABLE
  CASH_IN_TRANSIT
  BANK_CHARGES_EXPENSE
  BANK_INTEREST_INCOME
  RETAINED_EARNINGS
  OPENING_BALANCE_EQUITY
  FIXED_ASSET_PPE_CONTROL
  ACCUMULATED_DEPRECIATION_CONTROL
  DEPRECIATION_EXPENSE_CONTROL
  AP_WHT_PAYABLE
  AP_VAT_INPUT_CONTROL
  AP_PURCHASE_PRICE_VARIANCE
}

enum JournalType {
  STANDARD_MANUAL
  AR_BILLING
  PAYMENT_RECEIPT
  EXPENSE_DISBURSEMENT
  PAYROLL_ACCRUAL
  PAYROLL_PAYOUT
  STATUTORY_REMITTANCE
  INVENTORY_PURCHASE
  INVENTORY_COGS
  INVENTORY_ISSUE
  INVENTORY_WRITEOFF
  TREASURY_TRANSFER
  TREASURY_RECONCILIATION
  YEAR_END_CLOSE
  REVERSAL
  OPENING_BALANCE
  CAPITAL_PURCHASE
  DEPRECIATION
  ASSET_DISPOSAL
  AP_INVOICE_BILLING
  AP_PAYMENT_DISBURSEMENT
  AP_CREDIT_NOTE
  AP_PRICE_VARIANCE
  AP_SETTLEMENT_DISCOUNT
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model GLAccount {
  id            String            @id @default(cuid())
  branchId      String
  code          String            // e.g. "1120"
  name          String            // e.g. "Stanbic Collection Bank"
  accountType   GLAccountType
  normalBalance NormalBalance
  controlRole   SystemControlRole @default(NONE)
  isHeader      Boolean           @default(false)
  parentId      String?
  description   String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  branch              Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parent              GLAccount?         @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            GLAccount[]        @relation("AccountHierarchy")
  journalLines        JournalLine[]
  accountMappings     GLAccountMapping[]
  treasuryAccounts    TreasuryAccount[]
  feeTypes            FeeType[]
  expenseCategories   ExpenseCategory[]
  assetCategoryAssets AssetCategory[] @relation("CategoryAssetAccount")
  assetCategoryDeprec AssetCategory[] @relation("CategoryDeprecAccount")
  assetCategoryAccum  AssetCategory[] @relation("CategoryAccumDeprecAccount")
  supplierInvoiceLines SupplierInvoiceLine[]
  supplierCreditNoteLines SupplierCreditNoteLine[]

  @@unique([branchId, code])
  @@index([branchId, accountType])
  @@index([branchId, controlRole])
}

model FiscalYear {
  id        String         @id @default(cuid())
  branchId  String
  name      String         // e.g. "FY 2026"
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus   @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  periods   FiscalPeriod[]

  @@unique([branchId, name])
  @@index([branchId, status])
}

model FiscalPeriod {
  id           String         @id @default(cuid())
  branchId     String
  fiscalYearId String
  periodNumber Int            // 1 to 12
  name         String         // e.g. "January 2026"
  startDate    DateTime
  endDate      DateTime
  status       PeriodStatus   @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  closedBy       User?          @relation("PeriodClosedBy", fields: [closedById], references: [id])
  journalEntries JournalEntry[]
  depreciationRuns AssetDepreciationRun[]
  supplierInvoices SupplierInvoice[]
  supplierCreditNotes SupplierCreditNote[]

  @@unique([fiscalYearId, periodNumber])
  @@unique([branchId, name])
  @@index([branchId, status])
}

model JournalEntry {
  id             String        @id @default(cuid())
  branchId       String
  journalNumber  String        // JNL-2026-00001
  fiscalPeriodId String
  journalType    JournalType
  status         JournalStatus @default(POSTED)
  entryDate      DateTime
  postingDate    DateTime      @default(now())
  description    String
  referenceType  String?       // "INVOICE", "PAYMENT", "EXPENSE", "PAYROLL_RUN", "GRN", "SALE", "TRANSFER", "CASHBOOK_MOVEMENT", "MANUAL", "BOOTSTRAP"
  referenceId    String?
  idempotencyKey String?
  isReversal     Boolean       @default(false)
  reversalOfId   String?       @unique
  reversedById   String?
  postedById     String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalPeriod   FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  reversalOf     JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry? @relation("JournalReversal")
  postedBy       User          @relation("JournalPostedBy", fields: [postedById], references: [id])
  lines          JournalLine[]
  capitalizedAssets AssetItem[] @relation("AssetCapitalizationJournal")
  depreciationRun   AssetDepreciationRun?
  assetDisposal     AssetDisposal?
  supplierInvoice   SupplierInvoice?
  supplierCreditNote SupplierCreditNote?
  supplierPayment   SupplierPayment?

  @@unique([branchId, journalNumber])
  @@unique([branchId, idempotencyKey])
  @@unique([branchId, referenceType, referenceId, journalType])
  @@index([branchId, entryDate])
  @@index([branchId, status])
}

model JournalLine {
  id             String        @id @default(cuid())
  journalEntryId String
  branchId       String
  accountId      String
  lineNumber     Int
  description    String?
  debit          Decimal       @default(0.00) @db.Decimal(12, 2)
  credit         Decimal       @default(0.00) @db.Decimal(12, 2)
  departmentId   String?
  academicYearId String?
  termId         String?

  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  account        GLAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  term           Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([journalEntryId, lineNumber])
  @@index([branchId, accountId])
}

model GLAccountMapping {
  id          String            @id @default(cuid())
  branchId    String
  mappingKey  SystemControlRole // Target system role
  accountId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  account     GLAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([branchId, mappingKey])
}

model GLSequence {
  id        String   @id @default(cuid())
  branchId  String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year])
}

// ==========================================
// PHASE 3.1M: FIXED ASSETS & DEPRECIATION ENGINE
// ==========================================

enum AssetCategoryType {
  LAND_GROUNDS
  BUILDINGS_STRUCTURES
  MOTOR_VEHICLES_FLEET
  FURNITURE_FIXTURES
  COMPUTERS_ICT_EQUIPMENT
  MACHINERY_GENERATORS
  LABORATORY_APPARATUS
  CAPITAL_WORK_IN_PROGRESS
  OTHER_FIXED_ASSETS
}

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
  NONE
}

enum DepreciationFrequency {
  MONTHLY
  TERMLY
  ANNUALLY
}

enum AssetStatus {
  DRAFT
  ACTIVE
  IN_REPAIR
  FULLY_DEPRECIATED
  DISPOSED
  WRITTEN_OFF
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  UNUSABLE
}

enum CapitalizationSource {
  DIRECT_PURCHASE
  PROCUREMENT_GRN
  FLEET_VEHICLE
  INVENTORY_CONVERSION
  OPENING_BALANCE
  DONATION_GRANT
}

enum DepreciationRunStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum AssetDisposalType {
  SALE
  SCRAP
  INSURANCE_LOSS
  DONATION_OUT
  WRITE_OFF
}

model AssetCategory {
  id                      String             @id @default(cuid())
  branchId                String
  code                    String
  name                    String
  categoryType            AssetCategoryType  @default(OTHER_FIXED_ASSETS)
  description             String?
  depreciationMethod      DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths        Int                @default(36)
  annualDepreciationRate  Decimal            @default(0) @db.Decimal(5, 2)
  defaultSalvagePercent   Decimal            @default(0) @db.Decimal(5, 2)

  glAssetAccountId        String?
  glDepreciationAccountId String?
  glAccumDeprecAccountId  String?

  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  branch                  Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  glAssetAccount          GLAccount?         @relation("CategoryAssetAccount", fields: [glAssetAccountId], references: [id])
  glDepreciationAccount   GLAccount?         @relation("CategoryDeprecAccount", fields: [glDepreciationAccountId], references: [id])
  glAccumDeprecAccount    GLAccount?         @relation("CategoryAccumDeprecAccount", fields: [glAccumDeprecAccountId], references: [id])
  assets                  AssetItem[]

  @@unique([branchId, code])
  @@index([branchId, categoryType])
}

model AssetLocation {
  id          String      @id @default(cuid())
  branchId    String
  code        String
  name        String
  building    String?
  roomNumber  String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assets      AssetItem[]
  fromMovements AssetMovementLog[] @relation("MovementFromLocation")
  toMovements   AssetMovementLog[] @relation("MovementToLocation")
  verifications AssetVerificationLog[]

  @@unique([branchId, code])
  @@index([branchId])
}

model AssetItem {
  id                      String               @id @default(cuid())
  branchId                String
  assetTag                String
  name                    String
  description             String?
  categoryId              String
  locationId              String?
  custodianId             String?
  serialNumber            String?
  modelNumber             String?
  manufacturer            String?
  barcode                 String?

  purchaseDate            DateTime
  capitalizationDate      DateTime
  warrantyExpiry          DateTime?
  status                  AssetStatus          @default(ACTIVE)
  condition               AssetCondition       @default(GOOD)
  capitalizationSource    CapitalizationSource @default(DIRECT_PURCHASE)

  acquisitionCost         Decimal              @db.Decimal(12, 2)
  salvageValue            Decimal              @default(0) @db.Decimal(12, 2)
  depreciableBasis        Decimal              @db.Decimal(12, 2)
  accumulatedDepreciation Decimal              @default(0) @db.Decimal(12, 2)
  netBookValue            Decimal              @db.Decimal(12, 2)
  lastDepreciationDate    DateTime?

  depreciationMethod      DepreciationMethod?
  usefulLifeMonths        Int?
  annualDepreciationRate  Decimal?             @db.Decimal(5, 2)

  supplierId              String?
  grnId                   String?
  grnItemId               String?
  transportVehicleId      String?              @unique
  treasuryAccountId       String?
  capitalizationJournalId String?

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  branch                  Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category                AssetCategory        @relation(fields: [categoryId], references: [id])
  location                AssetLocation?       @relation(fields: [locationId], references: [id])
  custodian               Employee?            @relation("AssetCustodian", fields: [custodianId], references: [id])
  supplier                InventorySupplier?   @relation(fields: [supplierId], references: [id])
  grn                     GoodsReceivedNote?   @relation(fields: [grnId], references: [id])
  grnItem                 GoodsReceivedItem?   @relation(fields: [grnItemId], references: [id])
  transportVehicle        TransportVehicle?    @relation(fields: [transportVehicleId], references: [id])
  treasuryAccount         TreasuryAccount?     @relation(fields: [treasuryAccountId], references: [id])
  capitalizationJournal   JournalEntry?        @relation("AssetCapitalizationJournal", fields: [capitalizationJournalId], references: [id])

  depreciationLines       AssetDepreciationLine[]
  disposalRecord          AssetDisposal?
  verificationLogs        AssetVerificationLog[]
  movementLogs            AssetMovementLog[]

  @@unique([branchId, assetTag])
  @@index([branchId, status])
  @@index([branchId, categoryId])
  @@index([branchId, locationId])
  @@index([branchId, custodianId])
  @@index([branchId, grnId])
}

model AssetDepreciationRun {
  id                      String                @id @default(cuid())
  branchId                String
  runNumber               String
  periodId                String
  runDate                 DateTime
  status                  DepreciationRunStatus @default(DRAFT)
  totalAssetsCount        Int                   @default(0)
  totalDepreciationAmount Decimal               @default(0) @db.Decimal(12, 2)

  journalEntryId          String?               @unique
  createdById             String
  approvedById            String?
  approvedAt              DateTime?
  rejectionReason         String?
  notes                   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  branch                  Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fiscalPeriod            FiscalPeriod          @relation(fields: [periodId], references: [id])
  journalEntry            JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  createdBy               User                  @relation("DeprecCreatedBy", fields: [createdById], references: [id])
  approvedBy              User?                 @relation("DeprecApprovedBy", fields: [approvedById], references: [id])
  lines                   AssetDepreciationLine[]

  @@unique([branchId, runNumber])
  @@unique([branchId, periodId])
  @@index([branchId, status])
}

model AssetDepreciationLine {
  id                 String               @id @default(cuid())
  depreciationRunId  String
  assetId            String
  openingBookValue   Decimal              @db.Decimal(12, 2)
  depreciationAmount Decimal              @db.Decimal(12, 2)
  closingBookValue   Decimal              @db.Decimal(12, 2)
  depreciationMethod DepreciationMethod
  rateApplied        Decimal              @db.Decimal(5, 2)
  activeDaysInPeriod Int                  @default(30)
  totalDaysInPeriod  Int                  @default(30)
  createdAt          DateTime             @default(now())

  depreciationRun    AssetDepreciationRun @relation(fields: [depreciationRunId], references: [id], onDelete: Cascade)
  asset              AssetItem            @relation(fields: [assetId], references: [id])

  @@unique([depreciationRunId, assetId])
  @@index([depreciationRunId])
  @@index([assetId])
}

model AssetDisposal {
  id                     String            @id @default(cuid())
  branchId               String
  assetId                String            @unique
  disposalDate           DateTime
  disposalType           AssetDisposalType
  disposalProceeds       Decimal           @default(0) @db.Decimal(12, 2)

  costAtDisposal         Decimal           @db.Decimal(12, 2)
  accumDeprecAtDisposal   Decimal           @db.Decimal(12, 2)
  netBookValueAtDisposal Decimal           @db.Decimal(12, 2)
  gainOrLossAmount       Decimal           @db.Decimal(12, 2)

  reason                 String
  buyerDetails           String?
  treasuryAccountId      String?
  cashbookMovementId     String?           @unique
  journalEntryId         String?           @unique
  approvedById           String
  createdAt              DateTime          @default(now())

  branch                 Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  asset                  AssetItem         @relation(fields: [assetId], references: [id])
  treasuryAccount        TreasuryAccount?  @relation(fields: [treasuryAccountId], references: [id])
  cashbookMovement       CashbookMovement? @relation(fields: [cashbookMovementId], references: [id])
  journalEntry           JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  approvedBy             User              @relation("DisposalApprovedBy", fields: [approvedById], references: [id])

  @@index([branchId])
}

model AssetVerificationLog {
  id              String         @id @default(cuid())
  branchId        String
  assetId         String
  verifiedAt      DateTime       @default(now())
  verifiedById    String
  condition       AssetCondition
  locationId      String?
  custodianId     String?
  isMissing       Boolean        @default(false)
  notes           String?
  createdAt       DateTime       @default(now())

  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  asset           AssetItem      @relation(fields: [assetId], references: [id])
  verifiedBy      User           @relation("AssetVerifiedBy", fields: [verifiedById], references: [id])
  location        AssetLocation? @relation(fields: [locationId], references: [id])
  custodian       Employee?      @relation("VerificationCustodian", fields: [custodianId], references: [id])

  @@index([branchId, assetId])
  @@index([branchId, verifiedAt])
}

model AssetMovementLog {
  id              String         @id @default(cuid())
  branchId        String
  assetId         String
  fromLocationId  String?
  toLocationId    String?
  fromCustodianId String?
  toCustodianId   String?
  transferDate    DateTime       @default(now())
  reason          String?
  transferredById String
  createdAt       DateTime       @default(now())

  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  asset           AssetItem      @relation(fields: [assetId], references: [id])
  fromLocation    AssetLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocation      AssetLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id])
  fromCustodian   Employee?      @relation("MovementFromCustodian", fields: [fromCustodianId], references: [id])
  toCustodian     Employee?      @relation("MovementToCustodian", fields: [toCustodianId], references: [id])
  transferredBy   User           @relation("AssetTransferredBy", fields: [transferredById], references: [id])

  @@index([branchId, assetId])
}

model AssetSequence {
  id        String   @id @default(cuid())
  branchId  String
  type      String
  year      Int
  nextVal   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, type, year])
  @@index([branchId])
}

// ==========================================
// PHASE 3.1N: ACCOUNTS PAYABLE, SUPPLIER CREDIT MANAGEMENT & 3-WAY MATCHING
// ==========================================

enum SupplierInvoiceStatus {
  DRAFT
  MATCHED
  APPROVED
  PARTIALLY_PAID
  PAID
  DISPUTED
  ON_HOLD
  VOIDED
}

enum SupplierCreditNoteStatus {
  DRAFT
  APPROVED
  POSTED
  ALLOCATED
  VOIDED
}

enum SupplierPaymentStatus {
  COMPLETED
  REVERSED
  VOIDED
}

enum SupplyCategory {
  GOODS
  STANDARD_SERVICES
  MANAGEMENT_PROFESSIONAL_SERVICES
  CONSTRUCTION_WORKS
  RENT_PREMISES
}

enum InputVatTreatment {
  RECOVERABLE_INPUT_TAX
  NON_RECOVERABLE_EXPENSED
  NON_RECOVERABLE_CAPITALIZED
  EXEMPT
}

enum ThreeWayMatchStatus {
  PERFECT_MATCH
  PRICE_VARIANCE_PASS
  PRICE_VARIANCE_FAIL
  QUANTITY_VARIANCE_FAIL
  MANUAL_OVERRIDE
}

enum StatementMatchStatus {
  UNMATCHED
  EXACT_MATCH
  VARIANCE_REVIEW
  DISPUTED
}

model TaxPolicy {
  id                    String            @id @default(cuid())
  branchId              String
  name                  String
  supplyCategory        SupplyCategory
  isWhtApplicable       Boolean           @default(true)
  whtRatePercent        Decimal           @default(6.00) @db.Decimal(5, 2)
  whtThresholdAmount    Decimal           @default(1000000.00) @db.Decimal(14, 2)
  whtTaxableBaseRule    String            @default("GROSS_EXCLUDING_VAT")
  isVatApplicable       Boolean           @default(true)
  vatRatePercent        Decimal           @default(18.00) @db.Decimal(5, 2)
  inputVatTreatment     InputVatTreatment @default(NON_RECOVERABLE_EXPENSED)
  efrisEvidenceRequired Boolean           @default(true)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  branch                Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, supplyCategory, effectiveFrom, effectiveTo])
  @@index([branchId, isActive])
}

model SupplierInvoice {
  id                     String                @id @default(cuid())
  branchId               String
  invoiceNumber          String                // Sequence: PINV-2026-00001
  vendorInvoiceNumber    String                // Vendor's legal invoice ref
  supplierId             String
  poId                   String?
  grnId                  String?
  fiscalPeriodId         String
  invoiceDate            DateTime
  dueDate                DateTime
  supplyCategory         SupplyCategory        @default(GOODS)
  grossAmount            Decimal               @db.Decimal(14, 2)
  taxAmount              Decimal               @default(0) @db.Decimal(14, 2)
  discountAmount         Decimal               @default(0) @db.Decimal(14, 2)
  netPayableAmount       Decimal               @db.Decimal(14, 2)
  amountPaid             Decimal               @default(0) @db.Decimal(14, 2)
  amountOutstanding      Decimal               @db.Decimal(14, 2)
  ppvAmount              Decimal               @default(0) @db.Decimal(14, 2)
  status                 SupplierInvoiceStatus @default(DRAFT)
  matchStatus            ThreeWayMatchStatus?
  disputeReason          String?
  holdReason             String?
  efrisFiscalDocNumber   String?
  efrisVerificationCode  String?
  isOpeningBalance       Boolean               @default(false)
  notes                  String?
  createdById            String
  approvedById           String?
  approvedAt             DateTime?
  journalEntryId         String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  branch                 Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier               InventorySupplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  po                     PurchaseOrder?        @relation(fields: [poId], references: [id], onDelete: SetNull)
  grn                    GoodsReceivedNote?    @relation(fields: [grnId], references: [id], onDelete: SetNull)
  fiscalPeriod           FiscalPeriod          @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  createdBy              User                  @relation("SupplierInvoiceCreator", fields: [createdById], references: [id])
  approvedBy             User?                 @relation("SupplierInvoiceApprover", fields: [approvedById], references: [id])
  journalEntry           JournalEntry?         @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines                  SupplierInvoiceLine[]
  allocations            SupplierPaymentAllocation[]
  creditNotes            SupplierCreditNote[]

  @@unique([branchId, invoiceNumber])
  @@unique([branchId, supplierId, vendorInvoiceNumber])
  @@index([branchId, status, dueDate])
  @@index([branchId, supplierId])
}

model SupplierInvoiceLine {
  id                 String          @id @default(cuid())
  invoiceId          String
  branchId           String
  poItemId           String?
  grnItemId          String?
  itemId             String?
  expenseCategoryId  String?
  description        String
  quantityInvoiced   Decimal         @db.Decimal(12, 2)
  unitPriceInvoiced  Decimal         @db.Decimal(12, 2)
  unitCostSnapshot   Decimal         @default(0) @db.Decimal(12, 2)
  lineTotalCost      Decimal         @db.Decimal(14, 2)
  ppvAmount          Decimal         @default(0) @db.Decimal(14, 2)
  taxRate            Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(14, 2)
  glAccountId        String?
  createdAt          DateTime        @default(now())

  invoice            SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  grnItem            GoodsReceivedItem? @relation(fields: [grnItemId], references: [id], onDelete: SetNull)
  item               InventoryItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  expenseCategory    ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  glAccount          GLAccount?      @relation(fields: [glAccountId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([branchId, grnItemId])
}

model SupplierCreditNote {
  id                 String                   @id @default(cuid())
  branchId           String
  creditNoteNumber   String                   // Sequence: SCRN-2026-00001
  vendorCreditNoteRef String?
  supplierId         String
  originalInvoiceId  String?
  fiscalPeriodId     String
  creditNoteDate     DateTime
  grossAmount        Decimal                  @db.Decimal(14, 2)
  taxAmount          Decimal                  @default(0) @db.Decimal(14, 2)
  netCreditAmount    Decimal                  @db.Decimal(14, 2)
  unallocatedAmount  Decimal                  @db.Decimal(14, 2)
  reason             String
  status             SupplierCreditNoteStatus @default(DRAFT)
  journalEntryId     String?                  @unique
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  branch             Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier           InventorySupplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  originalInvoice    SupplierInvoice?         @relation(fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  fiscalPeriod       FiscalPeriod             @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  createdBy          User                     @relation("SupplierCreditNoteCreator", fields: [createdById], references: [id])
  approvedBy         User?                    @relation("SupplierCreditNoteApprover", fields: [approvedById], references: [id])
  journalEntry       JournalEntry?            @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines              SupplierCreditNoteLine[]

  @@unique([branchId, creditNoteNumber])
  @@index([branchId, supplierId])
  @@index([branchId, status])
}

model SupplierCreditNoteLine {
  id                 String             @id @default(cuid())
  creditNoteId       String
  branchId           String
  itemId             String?
  description        String
  quantityReturned   Decimal            @default(0) @db.Decimal(12, 2)
  unitPrice          Decimal            @db.Decimal(12, 2)
  lineTotal          Decimal            @db.Decimal(14, 2)
  glAccountId        String?
  createdAt          DateTime           @default(now())

  creditNote         SupplierCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item               InventoryItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  glAccount          GLAccount?         @relation(fields: [glAccountId], references: [id], onDelete: SetNull)

  @@index([creditNoteId])
}

model SupplierPayment {
  id                  String                     @id @default(cuid())
  branchId            String
  paymentNumber       String                     // Sequence: SPAY-2026-00001
  supplierId          String
  treasuryAccountId   String
  paymentDate         DateTime
  totalAmountPaid     Decimal                    @db.Decimal(14, 2)
  whtDeductedAmount   Decimal                    @default(0) @db.Decimal(14, 2)
  discountTakenAmount Decimal                    @default(0) @db.Decimal(14, 2)
  unallocatedAmount   Decimal                    @default(0) @db.Decimal(14, 2)
  paymentMethod       PaymentMethod
  referenceNumber     String?                    // Bank Cheque / EFT Ref
  notes               String?
  status              SupplierPaymentStatus      @default(COMPLETED)
  journalEntryId      String?                    @unique
  cashbookMovementId  String?                    @unique
  createdById         String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  branch              Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier            InventorySupplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  treasuryAccount     TreasuryAccount            @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  createdBy           User                       @relation("SupplierPaymentCreator", fields: [createdById], references: [id])
  journalEntry        JournalEntry?              @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  cashbookMovement    CashbookMovement?
  allocations         SupplierPaymentAllocation[]

  @@unique([branchId, paymentNumber])
  @@index([branchId, supplierId, paymentDate])
  @@index([branchId, status])
}

model SupplierPaymentAllocation {
  id                 String          @id @default(cuid())
  branchId           String
  paymentId          String
  invoiceId          String
  allocatedAmount    Decimal         @db.Decimal(14, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(14, 2)
  createdAt          DateTime        @default(now())

  payment            SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice            SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
}

model SupplierStatementImport {
  id                 String                  @id @default(cuid())
  branchId           String
  supplierId         String
  statementDate      DateTime
  statementRef       String?
  openingBalance     Decimal                 @db.Decimal(14, 2)
  closingBalance     Decimal                 @db.Decimal(14, 2)
  totalDebits        Decimal                 @default(0) @db.Decimal(14, 2)
  totalCredits       Decimal                 @default(0) @db.Decimal(14, 2)
  importedById       String
  notes              String?
  createdAt          DateTime                @default(now())

  branch             Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier           InventorySupplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  importedBy         User                    @relation("StatementImportedBy", fields: [importedById], references: [id])
  lines              SupplierStatementLine[]

  @@index([branchId, supplierId, statementDate])
}

model SupplierStatementLine {
  id                 String                  @id @default(cuid())
  statementImportId  String
  branchId           String
  transactionDate    DateTime
  referenceNumber    String
  description        String?
  debitAmount        Decimal                 @default(0) @db.Decimal(14, 2)
  creditAmount       Decimal                 @default(0) @db.Decimal(14, 2)
  balance            Decimal                 @db.Decimal(14, 2)
  matchStatus        StatementMatchStatus    @default(UNMATCHED)
  matchedInvoiceId   String?
  matchedPaymentId   String?
  matchedCreditNoteId String?
  notes              String?
  createdAt          DateTime                @default(now())

  statementImport    SupplierStatementImport @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
  branch             Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([statementImportId])
  @@index([branchId, matchStatus])
}

model SupplierSequence {
  id        String   @id @default(cuid())
  branchId  String
  type      String   // PINV, SCRN, SPAY
  year      Int
  nextVal   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, type, year])
  @@index([branchId])
}

// ==========================================
// PHASE 3.2B: STUDENT WELFARE, BOARDING, CLINIC & DISCIPLINE
// ==========================================

enum HostelGender {
  MALE
  FEMALE
  MIXED
}

enum RoomType {
  STANDARD_DORM
  CUBICLE
  PREFECT_ROOM
  SPECIAL_NEEDS
  SICK_BAY_RESERVE
}

enum BedType {
  SINGLE
  BUNK_LOWER
  BUNK_UPPER
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum BedAllocationStatus {
  ACTIVE
  TRANSFERRED
  RELEASED
  CANCELLED
}

enum RollCallStatus {
  PRESENT
  ABSENT
  SICKBAY
  AUTHORIZED_ABSENCE
}

enum TriagePriority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum DiagnosticCategory {
  MALARIA
  RESPIRATORY
  GASTROINTESTINAL
  DENTAL
  TRAUMA
  DERMATOLOGY
  OTHER
}

enum DisciplineCategory {
  BULLYING
  SUBSTANCE_ABUSE
  VANDALISM
  THEFT
  TRUANCY
  INSUBORDINATION
  FIGHTING
  ACADEMIC_DISHONESTY
  OTHER
}

enum IncidentSeverity {
  MINOR
  MODERATE
  MAJOR
  SEVERE
}

enum IncidentStatus {
  REPORTED
  INVESTIGATING
  HEARING_SCHEDULED
  RESOLVED
  DISMISSED
}

enum HearingPlea {
  GUILTY
  NOT_GUILTY
  NO_CONTEST
}

enum SanctionType {
  VERBAL_WARNING
  WRITTEN_WARNING
  DETENTION
  COMMUNITY_SERVICE
  LOSS_OF_PRIVILEGE
  SUSPENSION
  EXPULSION
}

enum SanctionStatus {
  ACTIVE
  SERVED
  APPEALED
  OVERTURNED
}

enum ExeatType {
  MEDICAL
  FAMILY_EMERGENCY
  OFFICIAL_SCHOOL_EVENT
  WEEKEND_EXEAT
}

enum ExeatStatus {
  PENDING
  APPROVED
  REJECTED
  DEPARTED
  COMPLETED
  CANCELLED
}

model Hostel {
  id          String       @id @default(cuid())
  branchId    String
  code        String
  name        String
  gender      HostelGender @default(MIXED)
  capacity    Int          @default(0)
  wardenId    String?
  matronId    String?
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warden      User?        @relation("HostelWarden", fields: [wardenId], references: [id], onDelete: SetNull)
  matron      User?        @relation("HostelMatron", fields: [matronId], references: [id], onDelete: SetNull)
  rooms       HostelRoom[]
  rollCalls   HostelRollCall[]

  @@unique([branchId, code])
  @@index([branchId, gender, isActive])
}

model HostelRoom {
  id          String     @id @default(cuid())
  branchId    String
  hostelId    String
  roomNumber  String
  floorNumber Int        @default(0)
  wing        String?
  roomType    RoomType   @default(STANDARD_DORM)
  capacity    Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  hostel      Hostel     @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  beds        HostelBed[]

  @@unique([hostelId, roomNumber])
  @@index([branchId, hostelId])
}

model HostelBed {
  id          String          @id @default(cuid())
  branchId    String
  roomId      String
  bedNumber   String
  bedCode     String
  bedType     BedType         @default(BUNK_LOWER)
  status      BedStatus       @default(AVAILABLE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room        HostelRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations BedAllocation[]

  @@unique([roomId, bedNumber])
  @@unique([branchId, bedCode])
  @@index([branchId, status])
}

model BedAllocation {
  id             String           @id @default(cuid())
  branchId       String
  studentId      String
  bedId          String
  academicYearId String
  termId         String?
  allocatedAt    DateTime         @default(now())
  releasedAt     DateTime?
  status         BedAllocationStatus @default(ACTIVE)
  allocatedById  String?
  releasedById   String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bed          HostelBed    @relation(fields: [bedId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  allocatedBy  User?        @relation("BedAllocator", fields: [allocatedById], references: [id], onDelete: SetNull)
  releasedBy   User?        @relation("BedReleaser", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([branchId, studentId, status])
  @@index([branchId, bedId, status])
}

model HostelRollCall {
  id          String         @id @default(cuid())
  branchId    String
  hostelId    String
  studentId   String
  date        DateTime       @default(now())
  status      RollCallStatus @default(PRESENT)
  remarks     String?
  takenById   String
  createdAt   DateTime       @default(now())

  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  hostel      Hostel         @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  takenBy     User           @relation("RollCallTaker", fields: [takenById], references: [id], onDelete: Cascade)

  @@unique([hostelId, studentId, date])
  @@index([branchId, date])
}

model HostelClearanceRecord {
  id                  String    @id @default(cuid())
  branchId            String
  studentId           String
  academicYearId      String
  termId              String?
  mattressReturned    Boolean   @default(true)
  roomKeysReturned    Boolean   @default(true)
  lockerKeysReturned  Boolean   @default(true)
  bunkConditionIntact Boolean   @default(true)
  damagesNoted        Boolean   @default(false)
  damageCostUGX       Decimal?  @db.Decimal(12, 2)
  damageDescription   String?
  invoiceId           String?
  status              String    @default("PENDING")
  inspectorStaffId    String?
  inspectedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  inspectorStaff User?        @relation("HostelInspector", fields: [inspectorStaffId], references: [id], onDelete: SetNull)

  @@unique([studentId, academicYearId, termId])
  @@index([branchId, status])
}

model ClinicEncounter {
  id                     String             @id @default(cuid())
  branchId               String
  studentId              String
  academicYearId         String
  termId                 String?
  encounterNumber        String
  attendingStaffId       String
  checkInAt              DateTime           @default(now())
  checkOutAt             DateTime?
  triagePriority         TriagePriority     @default(ROUTINE)
  temperature            Decimal?           @db.Decimal(4, 1)
  pulseRate              Int?
  bloodPressure          String?
  respiratoryRate        Int?
  weightKg               Decimal?           @db.Decimal(5, 2)
  chiefComplaint         String
  diagnosticCategory     DiagnosticCategory @default(OTHER)
  symptomsEncrypted      String?
  clinicalNotesEncrypted String?
  diagnosisEncrypted     String?
  outcome                String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  branch           Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student          Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term             Term?                    @relation(fields: [termId], references: [id], onDelete: SetNull)
  attendingStaff   User                     @relation("ClinicAttendant", fields: [attendingStaffId], references: [id], onDelete: Cascade)
  sickbayAdmission SickbayAdmission?
  referral         MedicalReferral?
  dispensations    ClinicDispensingRecord[]

  @@unique([branchId, encounterNumber])
  @@index([branchId, studentId, checkInAt])
}

model SickbayAdmission {
  id                 String    @id @default(cuid())
  branchId           String
  encounterId        String    @unique
  studentId          String
  bedNumber          String
  admittedAt         DateTime  @default(now())
  dischargedAt       DateTime?
  dischargeCondition String?
  attendingNurseId   String
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  encounter      ClinicEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendingNurse User            @relation("SickbayNurse", fields: [attendingNurseId], references: [id], onDelete: Cascade)

  @@index([branchId, studentId])
}

model MedicalReferral {
  id                         String    @id @default(cuid())
  branchId                   String
  encounterId                String    @unique
  studentId                  String
  externalFacilityName       String
  referralReason             String
  ambulanceDispatched        Boolean   @default(false)
  escortStaffId              String?
  guardianNotifiedAt         DateTime?
  guardianNotificationNotes  String?
  dispatchedAt               DateTime  @default(now())
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  encounter   ClinicEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  escortStaff User?           @relation("ReferralEscort", fields: [escortStaffId], references: [id], onDelete: SetNull)

  @@index([branchId, studentId])
}

model ClinicDispensingRecord {
  id                  String   @id @default(cuid())
  branchId            String
  encounterId         String
  studentId           String
  itemId              String
  storeId             String
  quantity            Int      @default(1)
  dosageInstructions  String
  dispensedById       String
  dispensedAt         DateTime @default(now())
  stockMovementId     String?
  createdAt           DateTime @default(now())

  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  encounter   ClinicEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  item        InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store       InventoryStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dispensedBy User            @relation("MedicineDispenser", fields: [dispensedById], references: [id], onDelete: Cascade)

  @@index([branchId, encounterId])
  @@index([branchId, studentId])
}

model DisciplinaryIncident {
  id             String             @id @default(cuid())
  branchId       String
  incidentNumber String
  title          String
  incidentDate   DateTime           @default(now())
  location       String?
  reportedById   String
  category       DisciplineCategory @default(OTHER)
  severity       IncidentSeverity   @default(MINOR)
  description    String
  witnessNotes   String?
  status         IncidentStatus     @default(REPORTED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reportedBy User               @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  students   IncidentStudent[]
  hearings   DisciplinaryHearing[]

  @@unique([branchId, incidentNumber])
  @@index([branchId, status])
}

model IncidentStudent {
  id         String      @id @default(cuid())
  branchId   String
  incidentId String
  studentId  String
  role       String      @default("PRIMARY_OFFENDER")
  plea       HearingPlea @default(NO_CONTEST)
  statement  String?
  createdAt  DateTime    @default(now())

  branch   Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  incident DisciplinaryIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  student  Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, studentId])
  @@index([branchId, studentId])
}

model DisciplinaryHearing {
  id              String      @id @default(cuid())
  branchId        String
  incidentId      String
  hearingDate     DateTime
  location        String?
  panelChairId    String
  panelMembers    String?
  studentPlea     HearingPlea @default(NOT_GUILTY)
  guardianPresent Boolean     @default(false)
  guardianId      String?
  hearingMinutes  String
  findings        String
  status          String      @default("COMPLETED")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  incident   DisciplinaryIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  panelChair User                 @relation("HearingChair", fields: [panelChairId], references: [id], onDelete: Cascade)
  guardian   Guardian?            @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  sanctions  DisciplinarySanction[]

  @@index([branchId, incidentId])
}

model DisciplinarySanction {
  id             String         @id @default(cuid())
  branchId       String
  hearingId      String
  studentId      String
  sanctionType   SanctionType
  startDate      DateTime       @default(now())
  endDate        DateTime?
  terms          String
  demeritPoints  Int            @default(0)
  approvedById   String
  status         SanctionStatus @default(ACTIVE)
  lifecycleLogId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  hearing    DisciplinaryHearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy User                @relation("SanctionApprover", fields: [approvedById], references: [id], onDelete: Cascade)

  @@index([branchId, studentId])
  @@index([branchId, sanctionType])
}

model ExeatPass {
  id                    String      @id @default(cuid())
  branchId              String
  exeatNumber           String
  studentId             String
  academicYearId        String
  termId                String?
  exeatType             ExeatType   @default(WEEKEND_EXEAT)
  reason                String
  intendedDeparture     DateTime
  expectedReturn        DateTime
  actualDeparture       DateTime?
  actualReturn          DateTime?
  guardianConsent       Boolean     @default(true)
  guardianId            String?
  guardianConsentMethod String?
  approvedById          String?
  approvedAt            DateTime?
  gateOfficerDepartId   String?
  gateOfficerReturnId   String?
  accompanyingAdult     String?
  status                ExeatStatus @default(PENDING)
  isOverdue             Boolean     @default(false)
  qrVerificationToken   String      @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  branch            Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term              Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  guardian          Guardian?    @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  approvedBy        User?        @relation("ExeatApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  gateOfficerDepart User?        @relation("GateOfficerDepart", fields: [gateOfficerDepartId], references: [id], onDelete: SetNull)
  gateOfficerReturn User?        @relation("GateOfficerReturn", fields: [gateOfficerReturnId], references: [id], onDelete: SetNull)

  @@unique([branchId, exeatNumber])
  @@index([branchId, studentId])
  @@index([branchId, status])
}

model EmergencyNotificationLog {
  id                     String   @id @default(cuid())
  branchId               String
  studentId              String
  guardianId             String
  notificationReason     String
  phoneDialed            String
  status                 String   @default("COMPLETED")
  callerStaffId          String
  guardianResponseNotes  String?
  timestamp              DateTime @default(now())

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  callerStaff User     @relation("EmergencyCaller", fields: [callerStaffId], references: [id], onDelete: Cascade)

  @@index([branchId, studentId])
}

model WelfareSequence {
  id        String   @id @default(cuid())
  branchId  String
  type      String   // CLN, DISC, EXT, BED
  year      Int
  nextVal   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, type, year])
  @@index([branchId])
}

