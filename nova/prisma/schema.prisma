generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// TENANCY & ORGANIZATION HIERARCHY
// ==========================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]
  users   User[]
  roles   Role[]
}

model School {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]
}

model Branch {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  users                     UserBranchAccess[]
  students                  Student[]
  classes                   Class[]
  academicYears             AcademicYear[]
  subjects                  Subject[]
  subjectCombinations       SubjectCombination[]
  gradeScales               GradeScale[]
  settings                  BranchSettings?
  departments               Department[]
  employeeTypes             EmployeeType[]
  employees                 Employee[]
  feeTypes                  FeeType[]
  feeStructures             FeeStructure[]
  discounts                 StudentFeeDiscount[]
  invoices                  Invoice[]
  invoiceSequences          InvoiceSequence[]
  ledgerEntries             StudentLedgerEntry[]
  payments                  Payment[]
  paymentAllocations        PaymentAllocation[]
  receipts                  Receipt[]
  paymentSequences          PaymentSequence[]
  receiptSequences          ReceiptSequence[]
  expenseCategories         ExpenseCategory[]
  expenses                  Expense[]
  expenseSequences          ExpenseSequence[]
  schoolPayConfig           SchoolPayConfig?
  schoolPayTransactions     SchoolPayTransaction[]
  schoolPaySyncLogs         SchoolPaySyncLog[]
  employeeCompensations     EmployeeCompensation[]
  salaryComponents          SalaryComponent[]
  payrollRuns               PayrollRun[]
  payslips                  Payslip[]
  payrollSequences          PayrollSequence[]
  budgets                   Budget[]
  budgetSequences           BudgetSequence[]
  requirementCatalogs       RequirementCatalog[]
  classRequirements         ClassRequirement[]
  studentRequirementRecords StudentRequirementRecord[]
  studentClearances         StudentClearance[]
  inKindHandoverLogs        InKindHandoverLog[]
  clearanceSequences        ClearanceSequence[]
  inKindReceiptSequences    InKindReceiptSequence[]
  transportRoutes           TransportRoute[]
  transportVehicles         TransportVehicle[]
  transportDrivers          TransportDriver[]
  vehicleRouteAssignments   VehicleRouteAssignment[]
  transportSubscriptions    StudentTransportSubscription[]
  vehicleFuelLogs           VehicleFuelLog[]
  vehicleMaintenanceLogs    VehicleMaintenanceLog[]
  inventoryStores           InventoryStore[]
  inventoryItems            InventoryItem[]
  inventoryStoreStocks      InventoryStoreStock[]
  inventorySuppliers        InventorySupplier[]
  purchaseOrders            PurchaseOrder[]
  goodsReceivedNotes        GoodsReceivedNote[]
  storeRequisitions         StoreRequisition[]
  studentStoreSales         StudentStoreSale[]
  inventorySequences        InventorySequence[]
  treasuryAccounts          TreasuryAccount[]
  cashbookMovements         CashbookMovement[]
  treasuryTransfers         TreasuryTransfer[]
  cashierShiftSessions      CashierShiftSession[]
  pettyCashImprests         PettyCashImprest[]
  pettyCashVouchers         PettyCashVoucher[]
  bankStatements            BankStatement[]
  bankStatementLines        BankStatementLine[]
  bankReconciliations       BankReconciliation[]
  treasurySequences         TreasurySequence[]
  StockMovement             StockMovement[]
  glAccounts                GLAccount[]
  fiscalYears               FiscalYear[]
  fiscalPeriods             FiscalPeriod[]
  journalEntries            JournalEntry[]
  journalLines              JournalLine[]
  glAccountMappings         GLAccountMapping[]
  glSequences               GLSequence[]
  assetCategories           AssetCategory[]
  assetLocations            AssetLocation[]
  assetItems                AssetItem[]
  assetDepreciationRuns     AssetDepreciationRun[]
  assetDisposals            AssetDisposal[]
  assetVerificationLogs     AssetVerificationLog[]
  assetMovementLogs         AssetMovementLog[]
  assetSequences            AssetSequence[]
  taxPolicies               TaxPolicy[]
  supplierInvoices          SupplierInvoice[]
  supplierInvoiceLines      SupplierInvoiceLine[]
  supplierCreditNotes       SupplierCreditNote[]
  supplierCreditNoteLines   SupplierCreditNoteLine[]
  supplierPayments          SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  supplierStatementImports  SupplierStatementImport[]
  supplierStatementLines    SupplierStatementLine[]
  supplierSequences         SupplierSequence[]
  admissionSequences        AdmissionSequence[]
  applicants                Applicant[]
  guardians                 Guardian[]
  studentGuardians          StudentGuardian[]
  familyGroups              FamilyGroup[]
  studentDocuments          StudentDocument[]
  applicantDocuments        ApplicantDocument[]
  studentLifecycleLogs      StudentLifecycleLog[]
  enrollmentProvisionings   EnrollmentProvisioning[]
  hostels                   Hostel[]
  hostelRooms               HostelRoom[]
  hostelBeds                HostelBed[]
  bedAllocations            BedAllocation[]
  hostelRollCalls           HostelRollCall[]
  hostelClearanceRecords    HostelClearanceRecord[]
  clinicEncounters          ClinicEncounter[]
  sickbayAdmissions         SickbayAdmission[]
  medicalReferrals          MedicalReferral[]
  clinicDispensations       ClinicDispensingRecord[]
  disciplinaryIncidents     DisciplinaryIncident[]
  incidentStudents          IncidentStudent[]
  disciplinaryHearings      DisciplinaryHearing[]
  disciplinarySanctions     DisciplinarySanction[]
  exeatPasses               ExeatPass[]
  emergencyNotifications    EmergencyNotificationLog[]
  welfareSequences          WelfareSequence[]
}

model BranchSettings {
  id                   String  @id @default(cuid())
  branchId             String  @unique
  brandingLogoUrl      String?
  brandingMotto        String?
  activeAcademicYearId String?
  activeTermId         String?

  branch             Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  activeAcademicYear AcademicYear? @relation(fields: [activeAcademicYearId], references: [id])
  activeTerm         Term?         @relation(fields: [activeTermId], references: [id])
}

// ==========================================
// AUTHENTICATION & AUTHORIZATION
// ==========================================

model User {
  id                  String     @id @default(cuid())
  organizationId      String
  email               String?    @unique
  phone               String?    @unique
  passwordHash        String
  firstName           String
  lastName            String
  userType            UserType // STAFF, PARENT, STUDENT
  status              UserStatus @default(ACTIVE)
  forcePasswordChange Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]
  branchAccess UserBranchAccess[]

  // Relations for specific user types
  employee Employee?

  auditLogs                 AuditLog[]
  finalizedResults          TermResult[]             @relation("FinalizedResults")
  createdPayrollRuns        PayrollRun[]             @relation("PayrollCreator")
  submittedPayrollRuns      PayrollRun[]             @relation("PayrollSubmitter")
  approvedPayrollRuns       PayrollRun[]             @relation("PayrollApprover")
  disbursedPayrollRuns      PayrollRun[]             @relation("PayrollDisburser")
  createdBudgets            Budget[]                 @relation("BudgetCreator")
  submittedBudgets          Budget[]                 @relation("BudgetSubmitter")
  approvedBudgets           Budget[]                 @relation("BudgetApprover")
  preparedBudgetRevisions   BudgetRevision[]         @relation("RevisionPreparer")
  authorizedBudgetRevisions BudgetRevision[]         @relation("RevisionAuthorizer")
  classRequirementsCreated  ClassRequirement[]       @relation("ClassRequirementCreatedBy")
  requirementsReceived      StudentRequirementItem[] @relation("RequirementReceivedBy")
  handoversReceived         InKindHandoverLog[]      @relation("HandoverReceivedBy")
  clearancesAuthorized      StudentClearance[]       @relation("ClearanceAuthorizedBy")
  clearancesRevoked         StudentClearance[]       @relation("ClearanceRevokedBy")
  createdPurchaseOrders     PurchaseOrder[]          @relation("POCreator")
  approvedPurchaseOrders    PurchaseOrder[]          @relation("POApprover")
  receivedGoodsNotes        GoodsReceivedNote[]      @relation("GRNReceiver")
  approvedStoreRequisitions StoreRequisition[]       @relation("RequisitionApprover")
  recordedStoreSales        StudentStoreSale[]       @relation("StoreSaleRecorder")
  performedStockMovements   StockMovement[]          @relation("StockMovementPerformer")
  custodianAccounts         TreasuryAccount[]        @relation("AccountCustodian")
  cashbookMovements         CashbookMovement[]       @relation("CashbookMovementCreatedBy")
  initiatedTransfers        TreasuryTransfer[]       @relation("TransferInitiator")
  approvedTransfers         TreasuryTransfer[]       @relation("TransferApprover")
  cashierShifts             CashierShiftSession[]    @relation("CashierShift")
  supervisedShifts          CashierShiftSession[]    @relation("ShiftSupervisor")
  custodianImprests         PettyCashImprest[]       @relation("PettyCustodian")
  requestedPettyVouchers    PettyCashVoucher[]       @relation("VoucherRequester")
  approvedPettyVouchers     PettyCashVoucher[]       @relation("VoucherApprover")
  importedBankStatements    BankStatement[]          @relation("StatementImporter")
  certifiedReconciliations  BankReconciliation[]     @relation("ReconcileCertifier")
  postedJournals            JournalEntry[]           @relation("JournalPostedBy")
  closedFiscalPeriods       FiscalPeriod[]           @relation("PeriodClosedBy")
  createdDepreciationRuns   AssetDepreciationRun[]   @relation("DeprecCreatedBy")
  approvedDepreciationRuns  AssetDepreciationRun[]   @relation("DeprecApprovedBy")
  approvedDisposals         AssetDisposal[]          @relation("DisposalApprovedBy")
  verifiedAssets            AssetVerificationLog[]   @relation("AssetVerifiedBy")
  transferredAssets         AssetMovementLog[]       @relation("AssetTransferredBy")
  createdSupplierInvoices     SupplierInvoice[]        @relation("SupplierInvoiceCreator")
  approvedSupplierInvoices    SupplierInvoice[]        @relation("SupplierInvoiceApprover")
  createdSupplierCreditNotes  SupplierCreditNote[]     @relation("SupplierCreditNoteCreator")
  approvedSupplierCreditNotes SupplierCreditNote[]     @relation("SupplierCreditNoteApprover")
  createdSupplierPayments     SupplierPayment[]        @relation("SupplierPaymentCreator")
  importedSupplierStatements  SupplierStatementImport[] @relation("StatementImportedBy")
  reviewedApplicants          Applicant[]               @relation("ApplicantReviewer")
  assessedApplicants          Applicant[]               @relation("ApplicantAssessor")
  decidedApplicants           Applicant[]               @relation("ApplicantDecider")
  authorizedLifecycles        StudentLifecycleLog[]     @relation("LifecycleAuthorizer")
  verifiedGuardians           Guardian[]                @relation("GuardianVerifier")
  verifiedStudentDocuments    StudentDocument[]         @relation("StudentDocVerifier")
  verifiedApplicantDocuments  ApplicantDocument[]       @relation("ApplicantDocVerifier")
  wardenHostels               Hostel[]                  @relation("HostelWarden")
  matronHostels               Hostel[]                  @relation("HostelMatron")
  allocatedBeds               BedAllocation[]           @relation("BedAllocator")
  releasedBeds                BedAllocation[]           @relation("BedReleaser")
  takenRollCalls              HostelRollCall[]          @relation("RollCallTaker")
  inspectedHostelClearances   HostelClearanceRecord[]   @relation("HostelInspector")
  attendedClinicEncounters    ClinicEncounter[]         @relation("ClinicAttendant")
  attendedSickbays            SickbayAdmission[]        @relation("SickbayNurse")
  escortedReferrals           MedicalReferral[]         @relation("ReferralEscort")
  dispensedMedicines          ClinicDispensingRecord[]  @relation("MedicineDispenser")
  reportedIncidents           DisciplinaryIncident[]    @relation("IncidentReporter")
  chairedHearings             DisciplinaryHearing[]     @relation("HearingChair")
  approvedSanctions           DisciplinarySanction[]    @relation("SanctionApprover")
  approvedExeatPasses         ExeatPass[]               @relation("ExeatApprover")
  departedExeatPasses         ExeatPass[]               @relation("GateOfficerDepart")
  returnedExeatPasses         ExeatPass[]               @relation("GateOfficerReturn")
  dialedEmergencyNotifications EmergencyNotificationLog[] @relation("EmergencyCaller")
}

enum UserType {
  STAFF
  PARENT
  STUDENT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Maps a user to a branch with a specific role, allowing users to have different roles in different branches.
model UserBranchAccess {
  id       String @id @default(cuid())
  userId   String
  branchId String
  roleId   String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g., "Admin", "Teacher", "Bursar"
  permissions    String[] // Array of permission strings e.g., ["students:read", "fees:write"]

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchAccess UserBranchAccess[]

  @@unique([organizationId, name])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// ACADEMICS FOUNDATION (PILOT)
// ==========================================

model AcademicYear {
  id        String   @id @default(cuid())
  branchId  String
  name      String // e.g., "2024-2025"
  startDate DateTime
  endDate   DateTime

  branch                    Branch                         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  terms                     Term[]
  enrollments               Enrollment[]
  classSubjects             ClassSubject[]
  branchSettings            BranchSettings[]
  feeStructures             FeeStructure[]
  feeDiscounts              StudentFeeDiscount[]
  invoices                  Invoice[]
  ledgerEntries             StudentLedgerEntry[]
  budgets                   Budget[]
  classRequirements         ClassRequirement[]
  studentRequirementRecords StudentRequirementRecord[]
  studentClearances         StudentClearance[]
  transportRoutes           TransportRoute[]
  vehicleRouteAssignments   VehicleRouteAssignment[]
  transportSubscriptions    StudentTransportSubscription[]
  purchaseOrders            PurchaseOrder[]
  goodsReceivedNotes        GoodsReceivedNote[]
  studentStoreSales         StudentStoreSale[]
  journalLines              JournalLine[]
  applicants                Applicant[]
  bedAllocations            BedAllocation[]
  hostelClearanceRecords    HostelClearanceRecord[]
  clinicEncounters          ClinicEncounter[]
  exeatPasses               ExeatPass[]
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String
  name           String // e.g., "Term 1"
  startDate      DateTime
  endDate        DateTime

  academicYear              AcademicYear                   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assessments               Assessment[]
  termResults               TermResult[]
  branchSettings            BranchSettings[]
  feeStructures             FeeStructure[]
  feeDiscounts              StudentFeeDiscount[]
  invoices                  Invoice[]
  ledgerEntries             StudentLedgerEntry[]
  budgets                   Budget[]
  classRequirements         ClassRequirement[]
  studentRequirementRecords StudentRequirementRecord[]
  studentClearances         StudentClearance[]
  transportRoutes           TransportRoute[]
  vehicleRouteAssignments   VehicleRouteAssignment[]
  transportSubscriptions    StudentTransportSubscription[]
  purchaseOrders            PurchaseOrder[]
  goodsReceivedNotes        GoodsReceivedNote[]
  studentStoreSales         StudentStoreSale[]
  journalLines              JournalLine[]
  bedAllocations            BedAllocation[]
  hostelClearanceRecords    HostelClearanceRecord[]
  clinicEncounters          ClinicEncounter[]
  exeatPasses               ExeatPass[]
}

model Class {
  id                  String  @id @default(cuid())
  branchId            String
  name                String // e.g., "Primary 1"
  capacity            Int?
  gradeScaleId        String?
  aggregationStrategy String? // e.g., "SUM_ALL", "BEST_8"

  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  gradeScale        GradeScale?        @relation(fields: [gradeScaleId], references: [id], onDelete: SetNull)
  streams           Stream[]
  students          Student[]
  enrollments       Enrollment[]
  classSubjects     ClassSubject[]
  feeStructures     FeeStructure[]
  classRequirements ClassRequirement[]
  targetApplicants  Applicant[]
}

model Stream {
  id      String @id @default(cuid())
  classId String
  name    String // e.g., "North", "South"

  classRef               Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  students               Student[]
  enrollments            Enrollment[]
  targetStreamApplicants Applicant[]
}

// ==========================================
// STUDENT & ATTENDANCE (PILOT)
// ==========================================

model Student {
  id          String        @id @default(cuid())
  branchId    String
  admissionNo String        @unique
  firstName   String
  lastName    String
  middleName  String?
  dateOfBirth DateTime?
  gender      String?
  status      StudentStatus @default(ACTIVE)

  // Current Enrollment
  classId  String?
  streamId String?

  // SchoolPay Uganda Integration
  schoolPayCode String?

  // Phase 3.2A: Extended Demographics & Identity
  nationality            String                 @default("Ugandan")
  nin                    String?                // AES-256-GCM encrypted NIN
  ninLookupHash          String?                // HMAC-SHA256 blind index
  linEmisNo              String?                // Learner Identification Number
  birthCertNo            String?
  passportNo             String?                // AES-256-GCM encrypted passport
  dayOrBoarding          BoardingStatus         @default(DAY)
  residentialAddress     String?
  villageLCI             String?
  parish                 String?
  subCounty              String?
  district               String?
  medicalEmergencyNotes  String?                // AES-256-GCM encrypted medical notes
  allergies              String?
  bloodGroup             String?
  specialNeeds           String?
  previousSchoolName     String?
  previousClass          String?
  pleIndexNo             String?
  pleAggregate           Int?
  pleDivision            String?
  uceIndexNo             String?
  uceAggregate           Int?
  familyGroupId          String?
  lifecycleStatus        StudentLifecycleStatus @default(ACTIVE)
  admissionDate          DateTime               @default(now())
  graduatedDate          DateTime?
  withdrawnDate          DateTime?
  applicantId            String?                @unique

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classRef    Class?       @relation(fields: [classId], references: [id])
  streamRef   Stream?      @relation(fields: [streamId], references: [id])
  familyGroup FamilyGroup? @relation(fields: [familyGroupId], references: [id], onDelete: SetNull)
  applicant   Applicant?   @relation("EnrolledStudentApplicant", fields: [applicantId], references: [id], onDelete: SetNull)

  attendance             DailyAttendanceRecord[]
  enrollments            Enrollment[]
  marks                  Mark[]
  feeDiscounts           StudentFeeDiscount[]
  invoices               Invoice[]
  ledgerEntries          StudentLedgerEntry[]
  payments               Payment[]
  receipts               Receipt[]
  schoolPayTransactions  SchoolPayTransaction[]
  requirementRecords     StudentRequirementRecord[]
  clearances             StudentClearance[]
  transportSubscriptions StudentTransportSubscription[]
  studentStoreSales      StudentStoreSale[]
  guardians              StudentGuardian[]
  documents              StudentDocument[]
  lifecycleLogs          StudentLifecycleLog[]
  provisionings          EnrollmentProvisioning[]
  bedAllocations         BedAllocation[]
  hostelRollCalls        HostelRollCall[]
  hostelClearanceRecords HostelClearanceRecord[]
  clinicEncounters       ClinicEncounter[]
  sickbayAdmissions      SickbayAdmission[]
  medicalReferrals       MedicalReferral[]
  clinicDispensations    ClinicDispensingRecord[]
  incidentStudents       IncidentStudent[]
  disciplinarySanctions  DisciplinarySanction[]
  exeatPasses            ExeatPass[]
  emergencyNotifications EmergencyNotificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, schoolPayCode])
  @@index([branchId, lifecycleStatus])
  @@index([branchId, ninLookupHash])
  @@index([branchId, linEmisNo])
}

enum BoardingStatus {
  DAY
  BOARDING
}

enum StudentLifecycleStatus {
  PROSPECTIVE
  ENROLLED
  ACTIVE
  SUSPENDED
  DEFERRED
  TRANSFERRED_OUT
  EXPELLED
  GRADUATED
  DECEASED
}

enum ApplicantStatus {
  INQUIRY
  SUBMITTED
  UNDER_REVIEW
  ASSESSMENT_SCHEDULED
  ADMISSION_OFFERED
  OFFER_ACCEPTED
  OFFER_REJECTED
  ENROLLED
  WAITLISTED
  WITHDRAWN
}

enum GuardianRelationship {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  SPONSOR
  NEXT_OF_KIN
  FOSTER_PARENT
  OTHER
}

enum DocumentType {
  BIRTH_CERTIFICATE
  PLE_RESULT_SLIP
  UCE_RESULT_SLIP
  UACE_RESULT_SLIP
  TRANSFER_LETTER_EMIS
  PASSPORT_PHOTO
  IMMUNIZATION_CARD
  NATIONAL_ID_NIN
  LEGAL_GUARDIANSHIP_DOC
  OTHER
}

enum DocVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ProvisioningTaskStatus {
  PENDING
  SKIPPED
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FATAL
}

model AdmissionSequence {
  id        String   @id @default(cuid())
  branchId  String
  type      String   // "APP", "ADM", "GRD", "FAM"
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, type, year])
}

model FamilyGroup {
  id               String   @id @default(cuid())
  branchId         String
  familyCode       String
  familyName       String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  students  Student[]
  guardians Guardian[]

  @@unique([branchId, familyCode])
}

model Guardian {
  id               String               @id @default(cuid())
  branchId         String
  guardianCode     String
  firstName        String
  lastName         String
  middleName       String?
  title            String?              // Mr., Mrs., Dr., etc.
  relationshipType GuardianRelationship @default(LEGAL_GUARDIAN)
  phonePrimary     String
  phoneSecondary   String?
  email            String?
  nationalId       String?              // Encrypted NIN
  ninLookupHash    String?              // HMAC blind index
  passportNo       String?              // Encrypted passport
  occupation       String?
  employer         String?
  workplaceAddress String?
  residentialAddress String?
  provenance       String               @default("MANUAL_INTAKE") // "MANUAL_INTAKE", "LEGACY_USER_MIGRATION"
  isVerified       Boolean              @default(false)
  verifiedById     String?
  verifiedAt       DateTime?
  familyGroupId    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  familyGroup FamilyGroup?        @relation(fields: [familyGroupId], references: [id], onDelete: SetNull)
  verifiedBy  User?               @relation("GuardianVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  students               StudentGuardian[]
  applicants             ApplicantGuardian[]
  hearingsAttended       DisciplinaryHearing[]
  exeatPasses            ExeatPass[]
  emergencyNotifications EmergencyNotificationLog[]

  @@unique([branchId, guardianCode])
  @@index([branchId, phonePrimary])
  @@index([branchId, ninLookupHash])
}

model StudentGuardian {
  id                     String               @id @default(cuid())
  branchId               String
  studentId              String
  guardianId             String
  relationship           GuardianRelationship
  isPrimaryContact       Boolean              @default(false)
  isFinancialSponsor     Boolean              @default(false)
  isEmergencyContact     Boolean              @default(false)
  hasPickupAuthorization Boolean              @default(false)
  receivesAcademicReports Boolean             @default(true)
  receivesSmsAlerts      Boolean              @default(true)
  accessPriority         Int                  @default(1)
  notes                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([branchId, studentId])
  @@index([branchId, guardianId])
}

model Applicant {
  id                     String          @id @default(cuid())
  branchId               String
  applicationNumber      String
  academicYearId         String
  targetClassId          String
  targetStreamId         String?
  firstName              String
  lastName               String
  middleName             String?
  gender                 String?
  dateOfBirth            DateTime?
  nationality            String          @default("Ugandan")
  nin                    String?         // Encrypted NIN
  ninLookupHash          String?         // Blind index
  linEmisNo              String?
  birthCertNo            String?
  passportNo             String?
  dayOrBoarding          BoardingStatus  @default(DAY)
  residentialAddress     String?
  villageLCI             String?
  parish                 String?
  subCounty              String?
  district               String?
  previousSchoolName     String?
  previousClass          String?
  pleIndexNo             String?
  pleAggregate           Int?
  pleDivision            String?
  uceIndexNo             String?
  uceAggregate           Int?
  medicalEmergencyNotes  String?         // Encrypted
  allergies              String?
  bloodGroup             String?
  specialNeeds           String?
  intendedTransportRouteId String?
  status                 ApplicantStatus @default(INQUIRY)
  applicationFeePaid     Boolean         @default(false)
  applicationPaymentId   String?
  assessmentScore        Float?
  assessmentNotes        String?
  assessedById           String?
  assessedAt             DateTime?
  reviewedById           String?
  reviewedAt             DateTime?
  decisionReason         String?
  decisionById           String?
  decisionDate           DateTime?
  offerValidUntil        DateTime?
  enrolledStudentId      String?         @unique
  createdById            String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  targetClass     Class               @relation(fields: [targetClassId], references: [id], onDelete: Cascade)
  targetStream    Stream?             @relation(fields: [targetStreamId], references: [id], onDelete: SetNull)
  assessedBy      User?               @relation("ApplicantAssessor", fields: [assessedById], references: [id], onDelete: SetNull)
  reviewedBy      User?               @relation("ApplicantReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  decisionBy      User?               @relation("ApplicantDecider", fields: [decisionById], references: [id], onDelete: SetNull)
  enrolledStudent Student?            @relation("EnrolledStudentApplicant")
  documents       ApplicantDocument[]
  guardians       ApplicantGuardian[]

  @@unique([branchId, applicationNumber])
  @@index([branchId, status])
  @@index([branchId, ninLookupHash])
  @@index([branchId, targetClassId])
}

model ApplicantGuardian {
  id                     String               @id @default(cuid())
  applicantId            String
  guardianId             String
  relationship           GuardianRelationship
  isPrimaryContact       Boolean              @default(false)
  isFinancialSponsor     Boolean              @default(false)
  isEmergencyContact     Boolean              @default(false)
  hasPickupAuthorization Boolean              @default(false)
  createdAt              DateTime             @default(now())

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  guardian  Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([applicantId, guardianId])
}

model StudentDocument {
  id                 String                @id @default(cuid())
  branchId           String
  studentId          String
  documentType       DocumentType
  documentTitle      String
  storageKey         String
  fileSizeBytes      Int?
  mimeType           String?
  sha256Checksum     String?
  verificationStatus DocVerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedById       String?
  verifiedAt         DateTime?
  uploadedById       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  branch     Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("StudentDocVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([branchId, studentId])
  @@index([branchId, verificationStatus])
}

model ApplicantDocument {
  id                 String                @id @default(cuid())
  branchId           String
  applicantId        String
  documentType       DocumentType
  documentTitle      String
  storageKey         String
  fileSizeBytes      Int?
  mimeType           String?
  sha256Checksum     String?
  verificationStatus DocVerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedById       String?
  verifiedAt         DateTime?
  uploadedById       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  applicant  Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  verifiedBy User?     @relation("ApplicantDocVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([branchId, applicantId])
}

model StudentLifecycleLog {
  id             String                 @id @default(cuid())
  branchId       String
  studentId      String
  fromStatus     StudentLifecycleStatus
  toStatus       StudentLifecycleStatus
  reason         String
  notes          String?
  effectiveDate  DateTime               @default(now())
  authorizedById String?
  clearanceId    String?
  createdAt      DateTime               @default(now())

  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorizedBy User?    @relation("LifecycleAuthorizer", fields: [authorizedById], references: [id], onDelete: SetNull)

  @@index([branchId, studentId])
  @@index([branchId, effectiveDate])
}

model EnrollmentProvisioning {
  id                 String                 @id @default(cuid())
  branchId           String
  studentId          String
  enrollmentId       String                 @unique
  overallStatus      ProvisioningTaskStatus @default(PENDING)
  
  billingStatus      ProvisioningTaskStatus @default(PENDING)
  billingInvoiceId   String?
  billingError       String?
  
  requirementsStatus ProvisioningTaskStatus @default(PENDING)
  requirementsError  String?
  
  transportStatus    ProvisioningTaskStatus @default(PENDING)
  transportError     String?
  
  storeOrderStatus   ProvisioningTaskStatus @default(PENDING)
  storeOrderError    String?
  
  schoolPayStatus    ProvisioningTaskStatus @default(PENDING)
  schoolPayError     String?
  
  retryCount         Int                    @default(0)
  maxRetries         Int                    @default(5)
  nextRetryAt        DateTime?
  lastAttemptAt      DateTime?
  
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([branchId, overallStatus])
  @@index([nextRetryAt])
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  SUSPENDED
  DROPPED_OUT
}

// TeacherProfile has been completely replaced by the Employee model in the HR Core phase.

model DailyAttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  notes     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ==========================================
// AUDIT LOGS
// ==========================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  schoolId       String?
  branchId       String?
  userId         String?
  action         String
  resourceType   String?
  resourceId     String?
  details        String?
  timestamp      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ==========================================
// ACADEMICS: ENROLLMENT & CURRICULUM
// ==========================================

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  academicYearId String
  classId        String
  streamId       String?
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  endedAt        DateTime?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classRef     Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  streamRef    Stream?      @relation(fields: [streamId], references: [id], onDelete: SetNull)

  enrollmentSubjects EnrollmentSubject[]
  termResults        TermResult[]
  invoices           Invoice[]
  requirementRecords StudentRequirementRecord[]
  provisioning       EnrollmentProvisioning?

  @@unique([studentId, academicYearId])
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  COMPLETED
  WITHDRAWN
}

model Subject {
  id          String  @id @default(cuid())
  branchId    String
  name        String
  code        String
  description String?
  isActive    Boolean @default(true)

  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classSubjects       ClassSubject[]
  combinationSubjects CombinationSubject[]
  enrollmentSubjects  EnrollmentSubject[]
  termResultSubjects  TermResultSubject[]
}

model ClassSubject {
  id             String  @id @default(cuid())
  classId        String
  subjectId      String
  academicYearId String
  teacherId      String?

  classRef     Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      Employee?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  assessments Assessment[]

  @@unique([classId, subjectId, academicYearId])
}

model SubjectCombination {
  id       String @id @default(cuid())
  branchId String
  name     String // e.g., "BCM"

  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  combinationSubjects CombinationSubject[]
}

model CombinationSubject {
  id            String  @id @default(cuid())
  combinationId String
  subjectId     String
  isCore        Boolean @default(true)

  combination SubjectCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([combinationId, subjectId])
}

model EnrollmentSubject {
  id           String  @id @default(cuid())
  enrollmentId String
  subjectId    String
  isElective   Boolean @default(false)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, subjectId])
}

// ==========================================
// ACADEMICS: ASSESSMENTS & GRADING
// ==========================================

model Assessment {
  id             String @id @default(cuid())
  classSubjectId String
  termId         String
  name           String // e.g., "Mid-Term"
  maxScore       Float
  weight         Float // percentage of final grade

  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)

  marks Mark[]

  @@unique([classSubjectId, termId, name])
}

model Mark {
  id           String     @id @default(cuid())
  studentId    String
  assessmentId String
  score        Float?
  status       MarkStatus @default(NOT_ENTERED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assessmentId])
}

enum MarkStatus {
  NOT_ENTERED
  SCORED
  ABSENT
  EXEMPT
  MALPRACTICE
}

model GradeScale {
  id          String  @id @default(cuid())
  branchId    String
  name        String // e.g., "O-Level Standard"
  description String?

  branch  Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bands   GradeBand[]
  classes Class[]

  @@unique([branchId, name])
}

model GradeBand {
  id           String  @id @default(cuid())
  gradeScaleId String
  minScore     Float
  maxScore     Float
  grade        String
  points       Int
  remarks      String?

  gradeScale GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)

  @@unique([gradeScaleId, grade])
}

model TermResult {
  id                  String       @id @default(cuid())
  enrollmentId        String
  termId              String
  totalScore          Float?
  aggregatePoints     Int?
  division            String?
  position            Int?
  totalStudents       Int?
  classTeacherComment String?
  headTeacherComment  String?
  conductRemark       String?
  status              ResultStatus @default(FINALIZED)
  version             Int          @default(1)
  finalizedAt         DateTime     @default(now())
  finalizedById       String?
  supersededById      String? // points to the new TermResult if superseded
  correctionReason    String?

  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  finalizedBy  User?        @relation("FinalizedResults", fields: [finalizedById], references: [id], onDelete: SetNull)
  supersededBy TermResult?  @relation("SupersededResults", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   TermResult[] @relation("SupersededResults")

  subjects TermResultSubject[]

  @@unique([enrollmentId, termId, version])
}

enum ResultStatus {
  FINALIZED
  SUPERSEDED
  WITHDRAWN
}

model TermResultSubject {
  id           String  @id @default(cuid())
  termResultId String
  subjectId    String
  score        Float?
  grade        String?
  points       Int?
  remarks      String?

  termResult TermResult @relation(fields: [termResultId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([termResultId, subjectId])
}

// ==========================================
// STAFF / HR CORE
// ==========================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

model Department {
  id          String  @id @default(cuid())
  branchId    String
  name        String
  description String?
  hodId       String? // Head of Department (NO @unique constraint to allow heading multiple departments)

  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  hod               Employee?          @relation("DepartmentHead", fields: [hodId], references: [id])
  employees         Employee[]
  storeRequisitions StoreRequisition[]
  pettyCashImprests PettyCashImprest[]
  journalLines      JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
}

model EmployeeType {
  id              String  @id @default(cuid())
  branchId        String
  name            String // e.g., "Teacher", "Bursar"
  description     String?
  isTeachingStaff Boolean @default(false) // Explicit flag for teacher eligibility

  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([branchId, name])
}

model Employee {
  id           String  @id @default(cuid())
  branchId     String
  employeeCode String // E.g., EMP-001
  firstName    String
  lastName     String
  email        String?
  phone        String?

  departmentId   String?
  employeeTypeId String

  status       EmployeeStatus @default(ACTIVE)
  joinedAt     DateTime       @default(now())
  terminatedAt DateTime?

  userId String? @unique

  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employeeType EmployeeType @relation(fields: [employeeTypeId], references: [id])
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Back-relation for Department HOD
  headedDepartments Department[] @relation("DepartmentHead")

  classSubjects     ClassSubject[] // Replaces TeacherProfile
  compensation      EmployeeCompensation?
  payslips          Payslip[]
  transportDrivers  TransportDriver[]
  managedStores     InventoryStore[]
  storeRequisitions StoreRequisition[]    @relation("RequisitionRequester")
  custodianAssets   AssetItem[]           @relation("AssetCustodian")
  custodianVerifications AssetVerificationLog[] @relation("VerificationCustodian")
  fromMovementLogs  AssetMovementLog[]    @relation("MovementFromCustodian")
  toMovementLogs    AssetMovementLog[]    @relation("MovementToCustodian")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, employeeCode])
}

// ==========================================
// FINANCE: FEE CONFIGURATION (PHASE 3.1A)
// ==========================================

model FeeType {
  id          String   @id @default(cuid())
  branchId    String
  name        String // e.g., "Tuition", "Boarding Fee", "Uniform"
  code        String // e.g., "TUITION", "BOARDING"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch           Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  structureItems   FeeStructureItem[]
  discounts        StudentFeeDiscount[]
  invoiceItems     InvoiceItem[]
  budgetItems      BudgetItem[]
  requirementItems ClassRequirementItem[]
  glAccountId      String?
  glAccount        GLAccount?             @relation(fields: [glAccountId], references: [id], onDelete: SetNull)

  @@unique([branchId, name])
  @@unique([branchId, code])
}

model FeeStructure {
  id             String   @id @default(cuid())
  branchId       String
  name           String // e.g., "S.1 Term 1 Standard"
  classId        String
  academicYearId String
  termId         String?
  description    String?
  currency       String   @default("UGX")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classRef     Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?              @relation(fields: [termId], references: [id], onDelete: SetNull)
  items        FeeStructureItem[]
  invoices     Invoice[]

  @@unique([branchId, classId, academicYearId, termId, name])
}

model FeeStructureItem {
  id             String    @id @default(cuid())
  feeStructureId String
  feeTypeId      String
  amount         Decimal   @db.Decimal(12, 2)
  isOptional     Boolean   @default(false)
  dueDate        DateTime?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeType      FeeType      @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)

  @@unique([feeStructureId, feeTypeId])
}

// ==========================================
// FINANCE: INVOICING & BILLING (PHASE 3.1B)
// ==========================================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model StudentFeeDiscount {
  id             String       @id @default(cuid())
  branchId       String
  studentId      String
  feeTypeId      String?
  academicYearId String?
  termId         String?
  discountType   DiscountType
  value          Decimal      @db.Decimal(12, 2)
  reason         String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeType      FeeType?      @relation(fields: [feeTypeId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  term         Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([branchId, studentId])
}

model Invoice {
  id             String        @id @default(cuid())
  branchId       String
  studentId      String
  enrollmentId   String
  academicYearId String
  termId         String?
  feeStructureId String?
  invoiceNumber  String
  billingKey     String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  grossAmount    Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  netAmount      Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  notes          String?
  voidReason     String?
  voidedAt       DateTime?
  voidedById     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment    Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term          Term?                @relation(fields: [termId], references: [id], onDelete: SetNull)
  feeStructure  FeeStructure?        @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  allocations   PaymentAllocation[]
  ledgerEntries StudentLedgerEntry[]

  @@unique([branchId, invoiceNumber])
  @@unique([branchId, billingKey])
  @@index([branchId, status])
  @@index([branchId, studentId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  feeTypeId   String?
  feeTypeName String
  description String?
  unitAmount  Decimal  @db.Decimal(12, 2)
  quantity    Int      @default(1)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeType FeeType? @relation(fields: [feeTypeId], references: [id], onDelete: SetNull)

  transportSubscriptions StudentTransportSubscription[]
  studentStoreSales      StudentStoreSale[]

  @@index([invoiceId])
}

model InvoiceSequence {
  id        String   @id @default(cuid())
  branchId  String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year])
}

// ==========================================
// FINANCE: SUBLEDGER & PAYMENTS (PHASE 3.1C)
// ==========================================

enum LedgerEntryType {
  INVOICE_GROSS_CHARGE
  BURSARY_CREDIT
  PAYMENT
  PAYMENT_REVERSAL
  OPENING_BALANCE
  INVOICE_VOID_REVERSAL
  BURSARY_VOID_REVERSAL
  CREDIT_ADJUSTMENT
  DEBIT_ADJUSTMENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MTN_MOMO
  AIRTEL_MONEY
  CHEQUE
  CARD
  SCHOOLPAY
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

enum AllocationStatus {
  ACTIVE
  REVERSED
}

enum ReceiptStatus {
  ISSUED
  VOID
}

model StudentLedgerEntry {
  id             String          @id @default(cuid())
  branchId       String
  studentId      String
  academicYearId String?
  termId         String?
  invoiceId      String?
  entryType      LedgerEntryType
  direction      LedgerDirection
  amount         Decimal         @db.Decimal(12, 2)
  referenceType  String // "INVOICE", "BURSARY", "PAYMENT", "SYSTEM_OPENING", "ADJUSTMENT"
  referenceId    String?
  description    String
  balanceAfter   Decimal         @db.Decimal(12, 2)
  postedAt       DateTime        @default(now())
  createdById    String?

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  term         Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([branchId, referenceType, referenceId, direction])
  @@index([branchId, studentId])
  @@index([branchId, postedAt])
}

model Payment {
  id                String        @id @default(cuid())
  branchId          String
  studentId         String
  idempotencyKey    String
  paymentNumber     String
  amount            Decimal       @db.Decimal(12, 2)
  paymentDate       DateTime      @default(now())
  paymentMethod     PaymentMethod
  externalReference String?
  payerName         String?
  payerPhone        String?
  status            PaymentStatus @default(COMPLETED)
  notes             String?
  collectedById     String
  reversalReason    String?
  reversedAt        DateTime?
  reversedById      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  branch                    Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student                   Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations               PaymentAllocation[]
  receipt                   Receipt?
  schoolPayTransaction      SchoolPayTransaction?
  monetizedRequirementItems StudentRequirementItem[]
  studentStoreSales         StudentStoreSale[]
  treasuryAccountId         String?
  treasuryAccount           TreasuryAccount?         @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)
  cashbookMovements         CashbookMovement[]

  @@unique([branchId, idempotencyKey])
  @@unique([branchId, paymentNumber])
  @@index([branchId, studentId])
  @@index([branchId, paymentDate])
  @@index([branchId, status])
}

model PaymentAllocation {
  id        String           @id @default(cuid())
  branchId  String
  paymentId String
  invoiceId String
  amount    Decimal          @db.Decimal(12, 2)
  status    AllocationStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
}

model Receipt {
  id            String        @id @default(cuid())
  branchId      String
  studentId     String
  paymentId     String        @unique
  receiptNumber String
  issuedAt      DateTime      @default(now())
  cashierName   String
  studentName   String
  admissionNo   String
  className     String
  amountFigures Decimal       @db.Decimal(12, 2)
  amountWords   String
  paymentMethod PaymentMethod
  externalRef   String?
  status        ReceiptStatus @default(ISSUED)
  voidedAt      DateTime?
  voidReason    String?

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([branchId, receiptNumber])
  @@index([branchId, studentId])
  @@index([branchId, issuedAt])
}

model PaymentSequence {
  id        String   @id @default(cuid())
  branchId  String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year])
}

model ReceiptSequence {
  id        String   @id @default(cuid())
  branchId  String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, year])
}

// ==========================================
// FINANCE: EXPENSES & CASH OUTFLOWS (PHASE 3.1D)
// ==========================================

enum ExpenseStatus {
  COMPLETED
  VOID
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  budgetItems       BudgetItem[]
  pettyCashVouchers PettyCashVoucher[]
  supplierInvoiceLines SupplierInvoiceLine[]
  glAccountId       String?
  glAccount         GLAccount?         @relation(fields: [glAccountId], references: [id], onDelete: SetNull)

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@index([branchId, isActive])
}

model Expense {
  id             String        @id @default(cuid())
  branchId       String
  categoryId     String
  idempotencyKey String
  voucherNumber  String
  title          String
  amount         Decimal       @db.Decimal(12, 2)
  expenseDate    DateTime      @default(now())
  paymentMethod  PaymentMethod
  vendorName     String?
  receiptRef     String?
  notes          String?
  status         ExpenseStatus @default(COMPLETED)
  voidedAt       DateTime?
  voidReason     String?
  voidedById     String?
  recordedById   String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch             Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category           ExpenseCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
