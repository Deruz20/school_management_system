  cashbookMovements  CashbookMovement[]
  pettyCashVouchers  PettyCashVoucher[]

  @@unique([branchId, idempotencyKey])
  @@unique([branchId, voucherNumber])
  @@index([branchId, expenseDate])
  @@index([branchId, categoryId])
  @@index([branchId, status])
